# ================================================================ iOS 相关

# Xcode 的用户私有数据（含断点、窗口状态、个人 scheme）。
# 共享 scheme 在 xcshareddata/ 下，那个要提交；这个不要。
*.xcuserdatad/
xcuserdata/
*.xcworkspace/xcuserdata/

# 构建产物
build/
DerivedData/
*.xcarchive
*.ipa
*.dSYM

# ================================================================ 密钥材料（绝对不能提交）

# ★ 安卓签名密钥库。
#
#   它和密码（build.ps1 里的 xtlure2026）是配套的：
#   密钥库丢了或换了，已装 App 的用户必须卸载重装，数据一起丢。
#
#   所以这个文件要**自己备份好**（网盘、密码管理器都行），
#   但不要放进任何公开仓库 —— 别人拿到它就能签出冒充你的 App。
keystore/
*.keystore
*.jks

# iOS 签名材料（本项目走免费自签路线，理论上不需要，但以防万一）
*.p12
*.mobileprovision
*.cer

# ================================================================ 构建中间产物

*.class
build/classes/
build/tests/
build/swift/
dist/

# ================================================================ 工具与编辑器

.vscode/
.idea/
*.swp
*~

# 工作记录与临时文件
_backup/
web/checkins/
*.log
