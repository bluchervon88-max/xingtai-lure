<?xml version="1.0" encoding="UTF-8"?>
<!--
    XtLure 的构建 scheme。

    ★ 为什么必须手写这个文件

      Xcode 平时会自动生成 scheme，但**只有在图形界面里打开过工程才会生成**。
      本项目的开发机是 Windows，没有 Xcode，CI 上也是全新检出，
      所以 `xcodebuild -scheme XtLure` 会因为"找不到 scheme"直接失败。

      scheme 文件放在 .xcodeproj/xcshareddata/xcschemes/ 下才叫"共享 scheme"
      （shared），能被 xcodebuild 和 CI 看到；放在 xcuserdata/ 下是私人 scheme，
      CI 读不到。

    ★ BuildableReference 里的几个 ID 必须与 project.pbxproj 完全一致

      BlueprintIdentifier   = 目标的 ID            （DD...0001）
      BuildableName         = 产物文件名          （XtLure.app）
      BlueprintName         = 目标名              （XtLure）
      ReferencedContainer   = 工程文件相对路径    （container:XtLure.xcodeproj）

      任何一处对不上，xcodebuild 会报
      "Scheme XtLure is not currently configured for the build action"
      或者更难查的 "missing target" 错误。
-->
<Scheme
   LastUpgradeVersion = "1500"
   version = "1.7">
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES">
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "YES"
            buildForRunning = "YES"
            buildForProfiling = "YES"
            buildForArchiving = "YES"
            buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "DD0000000000000000000001"
               BuildableName = "XtLure.app"
               BlueprintName = "XtLure"
               ReferencedContainer = "container:XtLure.xcodeproj">
            </BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
   </BuildAction>
   <TestAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      shouldUseLaunchSchemeArgsEnv = "YES">
      <Testables>
         <!--
            UI 测试目标。

            ★ 这一段不加的话，`xcodebuild test -scheme XtLure` 会报
              "Scheme XtLure is not currently configured for the test action"，
              或者更含糊的"没有可运行的测试"。

            为什么要有这个测试：开发机是 Windows、看不到 iPhone 屏幕，
            **诊断模块是唯一的观测通道**（把视图层级写成文件供导出）。
            但诊断代码依赖 UIKit，在 Windows 上一行都跑不了。
            这个测试在 CI 的模拟器上真正启动 App，
            验证诊断文件确实被写出、内容结构正确 ——
            避免用户装到真机上才发现拿不到任何数据。

            BlueprintIdentifier 必须与 project.pbxproj 里那个 target 的 ID 完全一致。
         -->
         <TestableReference
            skipped = "NO">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "DD0000000000000000000050"
               BuildableName = "XtLureUITests.xctest"
               BlueprintName = "XtLureUITests"
               ReferencedContainer = "container:XtLure.xcodeproj">
            </BuildableReference>
         </TestableReference>
      </Testables>
   </TestAction>
   <LaunchAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      launchStyle = "0"
      useCustomWorkingDirectory = "NO"
      ignoresPersistentStateOnLaunch = "NO"
      debugDocumentVersioning = "YES"
      debugServiceExtension = "internal"
      allowLocationSimulation = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "DD0000000000000000000001"
            BuildableName = "XtLure.app"
            BlueprintName = "XtLure"
            ReferencedContainer = "container:XtLure.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
   </LaunchAction>
   <ProfileAction
      buildConfiguration = "Release"
      shouldUseLaunchSchemeArgsEnv = "YES"
      savedToolIdentifier = ""
      useCustomWorkingDirectory = "NO"
      debugDocumentVersioning = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "DD0000000000000000000001"
            BuildableName = "XtLure.app"
            BlueprintName = "XtLure"
            ReferencedContainer = "container:XtLure.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
   </ProfileAction>
   <AnalyzeAction
      buildConfiguration = "Debug">
   </AnalyzeAction>
   <ArchiveAction
      buildConfiguration = "Release"
      revealArchiveInOrganizer = "YES">
   </ArchiveAction>
</Scheme>
